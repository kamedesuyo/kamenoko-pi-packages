+def prepare_profile(req, cfg):
+    local = cfg['local_comfy']
+    command = [str(cfg['exe']), '-s', '-X', 'utf8', str(local['runner']),
+               '--prepare', '--config', str(local['profiles_config'])]
+    result = subprocess.run(command, input=json.dumps(req), text=True, encoding='utf-8',
+                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=30,
+                            creationflags=getattr(subprocess, 'CREATE_NO_WINDOW', 0))
+    if result.returncode:
+        raise ValueError('profile: ' + result.stderr.strip().splitlines()[-1])
+    return json.loads(result.stdout)
 
 
